# ===== App config =====
APP_PASSWORD=cheese

# ===== User/Group IDs =====
# Set these to match your host user to avoid permission issues with bind mounts
# Run `id` on your host to find your UID/GID (usually 1000:1000)
PUID=1000
PGID=1000

# ===== qBittorrent =====
# These serve as initial defaults. Once configured via the Settings page (/settings),
# the values in config/settings.json take precedence over these env vars.
APP_QB_URL=http://qbittorrent:8080
APP_QB_USERNAME=admin
APP_QB_PASSWORD=adminadmin
APP_QB_BOOK_CATEGORY=books
APP_QB_AUDIOBOOK_CATEGORY=audiobooks

# ===== Search defaults =====
# These seed config/settings.json and remain the fallback when no value is saved.
APP_DEFAULT_SEARCH_CATEGORY=books
APP_PREFER_EPUB_ONLY=false
APP_PREFER_M4B=false

# ===== MAM auth =====
APP_MAM_USER_AGENT=Scurry/2.0 (+contact)

# ===== Mousehole Integration (Optional) =====
# Enable dynamic MAM token management via mousehole
# See docs/MOUSEHOLE.md for setup instructions
MOUSEHOLE_ENABLED=false
MOUSEHOLE_STATE_FILE=secrets/state.json
